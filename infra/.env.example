# Compose usa Postgres local por defecto. Para Supabase, define DATABASE_URL
# como postgresql+psycopg://... y DB_MODE=supabase en el archivo activo.
DB_MODE=local
DATABASE_URL=postgresql+psycopg://styleme:styleme_mvp@db:5432/styleme

# El proveedor VTON puede seguir configurándose por separado en infra/.env.
