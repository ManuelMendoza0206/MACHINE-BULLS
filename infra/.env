# Estado padrón del stack: el modo A del MVP (server CatVTON NATIVO en el
# GPU del host — puerto 7861) alcanzado por el backend/worker containerizados.
# Sin secretos: esto va al repo. Cambia el provider para otras demos:
#   VTON_PROVIDER=mock                        (PIL local, siempre funciona)
#   VTON_PROVIDER=http VTON_HTTP_URL=<vm>     (VM propia con IDM-VTON)
#   VTON_PROVIDER=replicate                   (requiere REPLICATE_API_TOKEN)
VTON_PROVIDER=mock
VTON_HTTP_URL=http://host.docker.internal:7861/tryon
# El frontend aborta el poll del job tras este timeout: un multicapa real
# (3 capas x ~50s GPU) superaba el default de 90s y el UI abortaba aunque
# el job seguia generando. NEXT_PUBLIC_* se hornea en build del contenedor.
NEXT_PUBLIC_VTON_POLL_TIMEOUT_MS=240000
