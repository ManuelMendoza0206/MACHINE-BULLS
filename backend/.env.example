# Runtime stage. In production, demo auth defaults off.
ENV=development
DATABASE_URL=sqlite:///./styleme.db
DB_MODE=local

# Authentication. Keep the JWT secret/JWKS settings in a secret manager.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
ALLOW_DEMO_AUTH=true
ALLOW_UNVERIFIED_JWT=false

# Rate limiting. TRUSTED_PROXY_IPS accepts explicit IPs/CIDRs only.
REDIS_URL=redis://localhost:6379/0
TRUSTED_PROXY_IPS=

# Upload limits enforced before decoding image contents.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000

VTON_PROVIDER=mock
VTON_HTTP_URL=
VTON_HTTP_TIMEOUT_S=300
REPLICATE_API_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
# URL publica del frontend: los enlaces de compartir apuntan a /looks/{token}.
FRONTEND_PUBLIC_URL=http://localhost:3000
# Secreto HS256 dedicado para firmar tokens de compartir (>=32 caracteres).
# Si se omite se usa SUPABASE_JWT_SECRET; en produccion es obligatorio.
VTON_SHARE_SECRET=
MEDIA_DIR=./media
HUMAN_PHOTO_RETENTION_HOURS=24
HUMAN_PHOTO_PURGE_INTERVAL_SECONDS=900
AZURE_STORAGE_CONNECTION_STRING=
