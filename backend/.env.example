# Runtime stage. In production, demo auth defaults off.
ENV=development
DATABASE_URL=sqlite:///./styleme.db

# Authentication. Keep the JWT secret/JWKS settings in a secret manager.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
ALLOW_DEMO_AUTH=true
ALLOW_UNVERIFIED_JWT=false

# Rate limiting. TRUSTED_PROXY_IPS accepts explicit IPs/CIDRs only.
REDIS_URL=redis://localhost:6379/0
TRUSTED_PROXY_IPS=

# Upload limits enforced before decoding image contents.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000

VTON_PROVIDER=mock
VTON_HTTP_URL=
VTON_HTTP_TIMEOUT_S=300
REPLICATE_API_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
MEDIA_DIR=./media
AZURE_STORAGE_CONNECTION_STRING=
