# Copy to .env.local and fill in. NEVER commit .env.local.
# Names must match openspec/specs/frontend/api-client-and-schemas/spec.md.

# Backend REST API (required — the API client fails at build/startup if missing)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth (landing-and-auth-flow)
# Usar la nueva Publishable Key (sb_pub_...) de Supabase (o NEXT_PUBLIC_SUPABASE_ANON_KEY para compatibilidad legacy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # legacy fallback

# Optional
NEXT_PUBLIC_VTON_POLL_TIMEOUT_MS=90000
