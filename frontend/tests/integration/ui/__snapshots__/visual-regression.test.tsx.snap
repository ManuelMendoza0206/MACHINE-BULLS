<div
  class="dark bg-background text-foreground"
>
  <div
    class="flex flex-col gap-3 w-64"
  >
    <div
      aria-valuemax="100"
      aria-valuemin="0"
      aria-valuenow="45"
      aria-valuetext="45%"
      class="relative h-2.5 w-full overflow-hidden border border-border bg-muted"
      role="progressbar"
    >
      <div
        aria-hidden="true"
        class="tick-rule absolute inset-0 opacity-70"
      />
      <div
        class="relative h-full bg-accent transition-[width] duration-700 ease-out"
        style="width: 45%;"
      />
    </div>
    <div
      aria-valuemax="100"
      aria-valuemin="0"
      aria-valuenow="100"
      aria-valuetext="100%"
      class="relative h-2.5 w-full overflow-hidden border border-border bg-muted"
      role="progressbar"
    >
      <div
        aria-hidden="true"
        class="tick-rule absolute inset-0 opacity-70"
      />
      <div
        class="relative h-full bg-accent transition-[width] duration-700 ease-out"
        style="width: 100%;"
      />
